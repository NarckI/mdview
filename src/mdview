def split_chunks(text, size=None):
    """Cut a big document into ~size-character pieces at blank lines between top-level blocks
    (never inside a fenced code block or a list/quote), repeating the link reference definitions
    in every piece so reference links still resolve."""
    size = size or CHUNK_CHARS
    lines = text.split("\n")
    refs = "\n".join(ln for ln in lines if REF_RE.match(ln))
    chunks, cur, n, fence = [], [], 0, None
    for i, ln in enumerate(lines):
        m = FENCE_RE.match(ln)
        if m:
            if fence is None:
                fence = m.group(1)
            elif ln.rstrip(" ") == fence:
                fence = None
        cur.append(ln)
        n += len(ln) + 1
        if n >= size and fence is None and not ln.strip():
            nxt = next((x for x in lines[i + 1:i + 60] if x.strip()), "")
            if nxt and not nxt[0].isspace() and not (UL_RE.match(nxt) or OL_RE.match(nxt) or QUOTE_RE.match(nxt)):
                chunks.append("\n".join(cur))
                cur, n = [], 0
    if cur:
        chunks.append("\n".join(cur))
    return [c + "\n\n" + refs for c in chunks] if refs else chunks


