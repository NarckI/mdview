# ---------- source <-> preview line mapping (for scroll sync) ----------
FENCE_RE = re.compile(r"^(`{3,}|~{3,})")
ATX_RE = re.compile(r"^#{1,6}")
SETEXT_RE = re.compile(r"^(?:=+|-+)[ ]*$")
HR_RE = re.compile(r"^ {0,3}(?:(?:-[ ]*){3,}|(?:\*[ ]*){3,}|(?:_[ ]*){3,})$")
INDENT_RE = re.compile(r"^(?: {4}|\t)")
QUOTE_RE = re.compile(r"^ {0,3}>")
UL_RE = re.compile(r"^ {0,3}[*+-][ ]+")
OL_RE = re.compile(r"^ {0,3}\d+\.[ ]+")
REF_RE = re.compile(r"^ {0,3}\[[^\]]+\]:[ ]*\S")


def scan_blocks(text):
    """Return (block_lines, heading_lines, total_lines): the 0-based source line where each
    top-level Markdown block (and each heading) starts. It mirrors how Python-Markdown splits
    a document; the preview checks the counts against the rendered page and falls back to
    heading-only (then percentage) sync when they disagree, so being approximate is safe."""
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    n = len(lines)
    starts, heads = [], []
    last = None      # kind of the most recent top-level block
    fresh = True     # the next non-blank line begins a new chunk
    i = 0
    while i < n:
        ln = lines[i]
        if not ln.strip():
            fresh = True
            i += 1
            continue
        if REF_RE.match(ln):          # link reference definitions render nothing
            i += 1
            continue
        if fresh and ln.startswith("<!--"):   # a comment block renders no element
            while i < n and "-->" not in lines[i]:
                i += 1
            i += 1
            continue
        m = FENCE_RE.match(ln)
        if m:
            j = i + 1
            while j < n and lines[j].rstrip(" ") != m.group(1):
                j += 1
            if j < n:
                starts.append(i)
                last, fresh, i = "fence", True, j + 1
                continue
        if ATX_RE.match(ln):
            starts.append(i)
            heads.append(i)
            last, fresh = "h", True
            i += 1
            continue
        if HR_RE.match(ln):
            starts.append(i)
            last, fresh = "hr", True
            i += 1
            continue
        if fresh:
            if i + 1 < n and SETEXT_RE.match(lines[i + 1]) and not INDENT_RE.match(ln):
                starts.append(i)
                heads.append(i)
                last, fresh = "h", True
                i += 2
                continue
            if INDENT_RE.match(ln):
                kind, merge = "code", last in ("code", "ul", "ol")
            elif QUOTE_RE.match(ln):
                kind, merge = "quote", last == "quote"
            elif UL_RE.match(ln):
                kind, merge = "ul", last == "ul"
            elif OL_RE.match(ln):
                kind, merge = "ol", last == "ol"
            else:
                kind, merge = "p", False
            if not merge:
                starts.append(i)
                last = kind
            fresh = False
        i += 1
    return starts, heads, n


def tag_call(text):
    blocks, heads, total = scan_blocks(text)
    return "mdTag(%s,%s,%d);" % (json.dumps(blocks), json.dumps(heads), total)


# ---------- find & replace (plain text or regular expressions) ----------
MATCH_LIMIT = 5000


def compile_query(text, regex, case):
    """Compile the Find box into a pattern. Raises re.error for a bad regular expression."""
    flags = re.MULTILINE | (0 if case else re.IGNORECASE)
    return re.compile(text if regex else re.escape(text), flags)


def find_spans(text, pat, limit=None):
    """(start, end) of every non-empty match, as character offsets."""
    out = []
    for m in pat.finditer(text):
        if m.end() > m.start():
            out.append((m.start(), m.end()))
            if limit and len(out) >= limit:
                break
    return out


def next_span(text, pat, pos):
    """First non-empty match starting at or after pos, wrapping around to the top."""
    for p in (pos, 0):
        while p <= len(text):
            m = pat.search(text, p)
            if not m:
                break
            if m.end() > m.start():
                return m.start(), m.end()
            p = m.end() + 1
    return None


def prev_span(text, pat, pos):
    """Last non-empty match starting before pos, wrapping around to the bottom."""
    spans = find_spans(text, pat, 100000)
    if not spans:
        return None
    k = bisect.bisect_left([s for s, _ in spans], pos) - 1
    return spans[k] if k >= 0 else spans[-1]


def expand(m, repl, regex):
    """Replacement text for match m. In regex mode \\1, \\g<name>, \\n work as in re.sub."""
    return m.expand(repl) if regex else repl


def replace_plan(text, pat, repl, regex):
    """[(start, end, new_text)] for every match whose replacement actually changes the text."""
    plan = []
    for m in pat.finditer(text):
        new = expand(m, repl, regex)
        if new != m.group():
            plan.append((m.start(), m.end(), new))
    return plan


# ---------- undo / redo ----------
class UndoStack:
    """Edit history. A group is a list of (kind, offset, text) ops, kind being "ins" or "del";
    one group is one undo step. Typing and backspacing runs are merged into a single step."""
    MERGE_SECS = 1.0
    MAX_GROUPS = 1000

    def __init__(self):
        self.clear()

    def clear(self):
        self.undo, self.redo = [], []
        self.pending, self.depth = [], 0
        self.clean, self.seal, self.stamp = None, False, 0.0

    def begin(self):          # GtkTextBuffer begin-user-action
        self.depth += 1

    def end(self, now):       # GtkTextBuffer end-user-action
        if self.depth:
            self.depth -= 1
        if self.depth == 0 and self.pending:
            ops, self.pending = self.pending, []
            self._commit(ops, now)

    def record(self, kind, offset, text, now):
        if self.depth:
            self.pending.append((kind, offset, text))
        else:
            self._commit([(kind, offset, text)], now)

    def _commit(self, ops, now):
        self.redo = []
        top = self.undo[-1] if self.undo else None
        if (top is not None and not self.seal and now - self.stamp < self.MERGE_SECS
                and self._joins(top[-1], ops)):
            top.extend(ops)
        else:
            self.undo.append(list(ops))
            if len(self.undo) > self.MAX_GROUPS:
                del self.undo[0]
        self.seal, self.stamp = False, now

    @staticmethod
    def _joins(last, ops):
        if len(ops) != 1:
            return False
        kind, off, text = ops[0]
        lkind, loff, ltext = last
        if kind != lkind or len(text) != 1 or len(ltext) != 1 or "\n" in (text, ltext):
            return False
        if kind == "ins":
            return off == loff + 1
        return off == loff or off + 1 == loff       # Delete key / Backspace

    def pop_undo(self):
        if not self.undo:
            return None
        group = self.undo.pop()
        self.redo.append(group)
        self.seal = True
        return group

    def pop_redo(self):
        if not self.redo:
            return None
        group = self.redo.pop()
        self.undo.append(group)
        self.seal = True
        return group

    def mark_clean(self):     # called after a save
        self.clean = self.undo[-1] if self.undo else None
        self.seal = True

    def is_clean(self):
        return (self.undo[-1] if self.undo else None) is self.clean


