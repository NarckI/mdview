        # ---------- theme ----------
        def is_dark(self):
            if self.theme != "auto":
                return self.theme == "dark"
            ctx = self.get_style_context()
            for name in ("theme_base_color", "theme_bg_color"):
                ok, c = ctx.lookup_color(name)
                if ok:
                    return 0.299 * c.red + 0.587 * c.green + 0.114 * c.blue < 0.5
            return False

        def refresh_palette(self):
            dark = self.is_dark()
            if dark != self._dark:
                self._dark = dark
                for d in self.docs:
                    d.apply_palette(dark)

        def sync_theme_ui(self):
            self.theme_btn.set_label(LABELS[self.theme])
            gs = Gtk.Settings.get_default()
            if self.theme == "auto":
                gs.reset_property("gtk-application-prefer-dark-theme")
            else:
                gs.set_property("gtk-application-prefer-dark-theme", self.theme == "dark")

        def cycle_theme(self):
            self.theme = THEMES[(THEMES.index(self.theme) + 1) % len(THEMES)]
            save_theme(self.theme)
            self.sync_theme_ui()
            if self.theme == "auto":
                js = "document.documentElement.removeAttribute('data-theme')"
            else:
                js = f"document.documentElement.setAttribute('data-theme','{self.theme}')"
            for d in self.docs:
                d.view.run_javascript(js, None, None, None)  # no reload: scroll position is kept
            GLib.idle_add(lambda: self.refresh_palette() or False)  # once GTK has restyled

        # ---------- tabs ----------
        def make_tab_label(self, d):
            d.tab_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            d.tab_label = Gtk.Label()
            d.tab_label.set_ellipsize(Pango.EllipsizeMode.END)
            d.tab_label.set_width_chars(10)   # without a minimum an ellipsized label can shrink to nothing
            d.tab_label.set_max_width_chars(24)
            close = Gtk.Button()
            close.set_relief(Gtk.ReliefStyle.NONE)
            close.set_focus_on_click(False)
            close.set_tooltip_text("Close tab (Ctrl+W)")
            close.add(Gtk.Image.new_from_icon_name("window-close-symbolic", Gtk.IconSize.MENU))
            close.connect("clicked", lambda *a: self.close_doc(d))
            d.tab_box.pack_start(d.tab_label, True, True, 0)
            d.tab_box.pack_start(close, False, False, 0)
            d.tab_box.show_all()

        def refresh_tab(self, d):
            name = os.path.basename(d.path) if d.path else "untitled"
            mark = "● " if d.dirty else ""
            if d.tab_label is not None:
                d.tab_label.set_text(mark + name)
                d.tab_box.set_tooltip_text(d.path or name)
            if d is self.doc:
                self.set_title(f"{mark}{name} - mdview")

        def doc_for(self, page):
            for d in self.docs:
                if d.paned == page:
                    return d
            return None

        def add_doc(self):
            d = Doc(self)
            self.make_tab_label(d)
            self.docs.append(d)
            self.notebook.append_page(d.paned, d.tab_box)
            self.notebook.set_tab_reorderable(d.paned, True)
            d.paned.show_all()   # the editor pane stays hidden until Edit is switched on
            self.notebook.set_show_tabs(len(self.docs) > 1)
            self.select(d)
            if self.doc is None:   # GTK did not announce the very first page
                self.on_switch_page(self.notebook, d.paned, 0)
            return d

        def select(self, d):
            self.notebook.set_current_page(self.notebook.page_num(d.paned))

        def touch(self, d):  # d becomes the most recently used tab
            if d in self.mru:
                self.mru.remove(d)
            self.mru.insert(0, d)

        def on_switch_page(self, nb, page, num):
            d = self.doc_for(page)
            if d is None or d is self.doc:
                return
            if self.doc is not None:
                self.clear_matches(self.doc)
            self.doc = d
            self.touch(d)
            self.sync_chrome()

        def sync_chrome(self):
            d = self.doc
            editing = d.editor_sw.get_visible()
            self.edit_btn.handler_block(self.edit_hid)
            self.edit_btn.set_active(editing)
            self.edit_btn.handler_unblock(self.edit_hid)
            self.save_btn.set_visible(editing)
            self.refresh_tab(d)
            self.update_nav()
            self.update_find_ui()
            self.refresh_find_context()

        def update_nav(self):
            d = self.doc
            self.back_btn.set_sensitive(bool(d and d.back))
            self.fwd_btn.set_sensitive(bool(d and d.fwd))

        def nav(self, back):
            if self.doc is not None:
                self.doc.go(back)

        def on_mouse(self, widget, ev):
            if ev.button in (8, 9) and self.doc is not None:   # the mouse's back / forward buttons
                self.doc.go(ev.button == 8)
                return True
            return False

        def open_path(self, path):
            if path.lower().endswith(CONVERT_EXTS):   # Word / OpenDocument: convert, then open the result
                return self.convert_and_open(path)
            path = os.path.realpath(path)
            for d in self.docs:
                if d.path and os.path.realpath(d.path) == path:
                    self.select(d)
                    return d
            d = self.add_doc()
            d.load(path)
            return d

        def convert_and_open(self, src):
            """Convert a .docx/.odt to Markdown (asking where to save it) and open the result in a tab."""
            dlg = Gtk.FileChooserDialog(title="Convert to Markdown: save as", parent=self,
                                        action=Gtk.FileChooserAction.SAVE)
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Convert", Gtk.ResponseType.OK)
            dlg.set_do_overwrite_confirmation(True)
            dlg.set_current_folder(os.path.dirname(os.path.abspath(src)))
            dlg.set_current_name(os.path.splitext(os.path.basename(src))[0] + ".md")
            dest = dlg.get_filename() if dlg.run() == Gtk.ResponseType.OK else None
            dlg.destroy()
            if not dest:
                return None
            if not dest.lower().endswith((".md", ".markdown", ".mdown")):
                dest += ".md"
            try:
                dest, _ = convert_file(src, dest)
            except ConvertError as e:
                self.message(f"Could not convert {os.path.basename(src)}:\n{e}")
                return None
            return self.open_path(dest)

        def close_current(self):
            if self.doc is not None:
                self.close_doc(self.doc)

        def close_doc(self, d):
            if not self.confirm_discard(d):
                return
            if len(self.docs) == 1:
                self.destroy()
                return
            self.docs.remove(d)
            self.mru.remove(d)
            if d is self.doc:
                self.select(self.mru[0])   # fall back to the most recently used tab
            self.notebook.remove_page(self.notebook.page_num(d.paned))
            self.notebook.set_show_tabs(len(self.docs) > 1)
            d.dispose()

        def step_tab(self, delta):  # plain left/right order, as shown on the tab bar
            n = self.notebook.get_n_pages()
            if n > 1:
                self.notebook.set_current_page((self.notebook.get_current_page() + delta) % n)

        def confirm_discard(self, d):
            """True if it is OK to close this document."""
            if not d.dirty:
                return True
            self.select(d)
            name = os.path.basename(d.path) if d.path else "untitled"
            dlg = Gtk.MessageDialog(parent=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                    text=f"Save changes to {name}?")
            dlg.format_secondary_text("Your changes will be lost if you don't save them.")
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Discard", Gtk.ResponseType.REJECT,
                            "Save", Gtk.ResponseType.ACCEPT)
            r = dlg.run()
            dlg.destroy()
            if r == Gtk.ResponseType.ACCEPT:
                d.save()
                return not d.dirty
            return r == Gtk.ResponseType.REJECT

        def confirm_all(self):
            return all(self.confirm_discard(d) for d in list(self.docs))

        def message(self, text):
            dlg = Gtk.MessageDialog(parent=self, modal=True, message_type=Gtk.MessageType.ERROR,
                                    buttons=Gtk.ButtonsType.OK, text=text)
            dlg.run()
            dlg.destroy()

        # ---------- most-recently-used tab switching (Ctrl+Tab) ----------
        def build_switcher(self):
            self.switcher = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            self.switcher.set_name("mdview-switcher")
            self.switcher.set_halign(Gtk.Align.CENTER)
            self.switcher.set_valign(Gtk.Align.CENTER)
            self.switcher.set_no_show_all(True)
            self.switcher.hide()
            css = Gtk.CssProvider()
            try:
                css.load_from_data(b"#mdview-switcher { background: rgba(32,34,38,0.95); color: #ffffff;"
                                   b" border-radius: 8px; padding: 8px; }"
                                   b"#mdview-switcher label { padding: 4px 14px; border-radius: 5px; }"
                                   b"#mdview-switcher label.sel { background: #0969da; }")
                Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                         Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            except GLib.Error:
                pass
            return self.switcher

        def mru_step(self, delta):
            """Ctrl+Tab walks back through the tabs in most-recently-used order and Ctrl+Shift+Tab
            walks forward again. Nothing is switched until Ctrl is released."""
            if len(self.mru) < 2:
                return
            if not self.switching:
                self.switching, self.sw_list, self.sw_i = True, list(self.mru), 0
            self.sw_i = (self.sw_i + delta) % len(self.sw_list)
            self.mru_show()

        def mru_show(self):
            for child in self.switcher.get_children():
                self.switcher.remove(child)
            home = os.path.expanduser("~")
            lo = max(0, min(self.sw_i - 7, len(self.sw_list) - 15))
            for i in range(lo, min(len(self.sw_list), lo + 15)):
                d = self.sw_list[i]
                name = os.path.basename(d.path) if d.path else "untitled"
                where = os.path.dirname(d.path) if d.path else ""
                if where.startswith(home):
                    where = "~" + where[len(home):]
                lbl = Gtk.Label()
                lbl.set_xalign(0)
                lbl.set_markup("%s%s   <small>%s</small>" % ("● " if d.dirty else "",
                                                            htmlmod.escape(name, quote=False),
                                                            htmlmod.escape(where, quote=False)))
                if i == self.sw_i:
                    lbl.get_style_context().add_class("sel")
                self.switcher.pack_start(lbl, False, False, 0)
                lbl.show()
            self.switcher.show()

        def mru_commit(self):
            if not self.switching:
                return
            self.switching = False
            self.switcher.hide()
            target = self.sw_list[self.sw_i]
            if target in self.docs and target is not self.doc:
                self.select(target)

        def mru_cancel(self):
            self.switching = False
            self.switcher.hide()

        def on_key_press(self, win, ev):
            state = ev.state & Gtk.accelerator_get_default_mod_mask()
            key = ev.keyval
            if state & CTRL and key in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab, Gdk.KEY_KP_Tab):
                back = key == Gdk.KEY_ISO_Left_Tab or bool(state & SHIFT)
                self.mru_step(-1 if back else 1)
                return True
            if self.switching and key == Gdk.KEY_Escape:
                self.mru_cancel()
                return True
            if state == CTRL and key in (Gdk.KEY_Page_Down, Gdk.KEY_Page_Up):
                self.step_tab(1 if key == Gdk.KEY_Page_Down else -1)
                return True
            if state == ALT and key in (Gdk.KEY_Left, Gdk.KEY_Right) and self.doc is not None:
                self.doc.go(key == Gdk.KEY_Left)
                return True
            if state == ALT and Gdk.KEY_1 <= key <= Gdk.KEY_9:
                n = key - Gdk.KEY_1
                if n < self.notebook.get_n_pages():
                    self.notebook.set_current_page(n)
                return True
            return False

        def on_key_release(self, win, ev):
            if ev.keyval in (Gdk.KEY_Control_L, Gdk.KEY_Control_R):
                self.mru_commit()
            return False

        # ---------- editing ----------
        def on_edit_toggled(self, btn):
            d = self.doc
            if d is None:
                return
            if btn.get_active():
                d.ensure_buffer()
                d.editor.show()
                d.editor_sw.show()
                self.save_btn.show()
                d.paned.set_position(max(300, self.get_allocated_width() // 2))
                d.editor.grab_focus()
            else:
                d.editor_sw.hide()
                self.save_btn.hide()
            self.update_find_ui()
            self.refresh_find_context()

        def save(self):
            if self.doc is not None:
                self.doc.save()

        def reload(self):
            if self.doc is not None and self.doc.path:
                self.doc.load(self.doc.path)

        def history(self, redo):
            """Ctrl+Z / Ctrl+Y: only while the editor has focus, so text fields keep their own keys."""
            d = self.doc
            if d is None or not d.editor.has_focus():
                return False
            d.step_history(not redo)
            return True

        def on_doc_edited(self, d):
            if d is self.doc and self.findbar.get_visible() and self.editing():
                self.schedule_find_update()

        # ---------- find & replace ----------
        def build_findbar(self):
            self.findbar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            self.findbar.set_border_width(6)

            row1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            self.find_entry = Gtk.SearchEntry()
            self.find_entry.set_placeholder_text("Find")
            self.find_entry.set_width_chars(30)
            self.find_entry.connect("search-changed", lambda *a: self.on_find_changed())
            self.find_entry.connect("activate", lambda *a: self.find_step(False))
            self.find_entry.connect("next-match", lambda *a: self.find_step(False))
            self.find_entry.connect("previous-match", lambda *a: self.find_step(True))
            self.find_entry.connect("stop-search", lambda *a: self.close_find())
            self.find_entry.connect("key-press-event", self.on_find_key)
            prev_btn = Gtk.Button(label="▲")
            prev_btn.set_tooltip_text("Previous match (Shift+F3)")
            prev_btn.connect("clicked", lambda *a: self.find_step(True))
            next_btn = Gtk.Button(label="▼")
            next_btn.set_tooltip_text("Next match (F3 / Enter)")
            next_btn.connect("clicked", lambda *a: self.find_step(False))
            self.case_chk = Gtk.CheckButton(label="Match case")
            self.case_chk.connect("toggled", lambda *a: self.on_find_changed())
            self.regex_chk = Gtk.CheckButton(label="Regex")
            self.regex_chk.set_tooltip_text("Regular expression (edit mode). In Replace, \\1 and \\g<name> "
                                            "refer to groups and \\n is a newline.")
            self.regex_chk.connect("toggled", lambda *a: self.on_find_changed())
            self.count_lbl = Gtk.Label(label="")
            close_btn = Gtk.Button(label="✕")
            close_btn.set_relief(Gtk.ReliefStyle.NONE)
            close_btn.connect("clicked", lambda *a: self.close_find())
            for w in (self.find_entry, prev_btn, next_btn, self.case_chk, self.regex_chk, self.count_lbl):
                row1.pack_start(w, False, False, 0)
            row1.pack_end(close_btn, False, False, 0)

            self.replace_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            self.replace_entry = Gtk.Entry()
            self.replace_entry.set_placeholder_text("Replace with")
            self.replace_entry.set_width_chars(30)
            self.replace_entry.connect("activate", lambda *a: self.replace_current())
            self.replace_entry.connect("key-press-event", self.on_find_key)
            rep_btn = Gtk.Button(label="Replace")
            rep_btn.connect("clicked", lambda *a: self.replace_current())
            all_btn = Gtk.Button(label="Replace All")
            all_btn.connect("clicked", lambda *a: self.replace_all())
            for w in (self.replace_entry, rep_btn, all_btn):
                self.replace_row.pack_start(w, False, False, 0)

            self.findbar.pack_start(row1, False, False, 0)
            self.findbar.pack_start(self.replace_row, False, False, 0)
            row1.show_all()
            self.replace_row.show_all()
            self.replace_row.set_no_show_all(True)
            self.replace_row.hide()
            self.findbar.set_no_show_all(True)
            self.findbar.hide()
            return self.findbar

        def editing(self):
            return self.edit_btn.get_active()

        def case_sensitive(self):
            return self.case_chk.get_active()

        def web_opts(self):
            o = WebKit2.FindOptions.WRAP_AROUND
            if not self.case_sensitive():
                o |= WebKit2.FindOptions.CASE_INSENSITIVE
            return o

        def update_find_ui(self):
            self.regex_chk.set_sensitive(self.editing())   # the preview's search is plain text only

        def compile_find(self, text):
            """(pattern, None) for the Find box, or (None, message) when the regex is invalid."""
            try:
                return compile_query(text, self.regex_chk.get_active() and self.editing(),
                                     self.case_sensitive()), None
            except re.error:
                return None, "Invalid regex"

        def replacement(self, m):
            return expand(m, self.replace_entry.get_text(), self.regex_chk.get_active())

        def open_find(self, replace=False):
            d = self.doc
            if d is None:
                return
            if replace and not self.editing():
                self.edit_btn.set_active(True)  # replacing needs the editor
            self.findbar.show()
            self.update_find_ui()
            if self.editing():
                self.replace_row.show()
                if d.buffer.get_has_selection():
                    a, b = d.buffer.get_selection_bounds()
                    sel = d.buffer.get_text(a, b, True)
                    if sel and "\n" not in sel:
                        self.find_entry.set_text(sel)
            else:
                self.replace_row.hide()
            self.find_entry.grab_focus()
            self.find_entry.select_region(0, -1)
            self.on_find_changed()

        def close_find(self):
            self.findbar.hide()
            self.clear_matches()
            if self.editing() and self.doc is not None:
                self.doc.editor.grab_focus()

        def clear_matches(self, d=None):
            d = d or self.doc
            if d is None:
                return
            start, end = d.buffer.get_bounds()
            d.buffer.remove_tag(d.match_tag, start, end)
            d.view.get_find_controller().search_finish()

        def refresh_find_context(self):
            if not self.findbar.get_visible() or self.doc is None:
                return
            if self.editing():
                self.replace_row.show()
            else:
                self.replace_row.hide()
            self.clear_matches()
            self.on_find_changed()

        def on_find_key(self, widget, event):
            if event.keyval == Gdk.KEY_Escape:
                self.close_find()
                return True
            if (widget is self.find_entry and event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter)
                    and event.state & Gdk.ModifierType.SHIFT_MASK):
                self.find_step(True)
                return True
            return False

        def on_find_changed(self):
            d = self.doc
            if d is None:
                return
            text = self.find_entry.get_text()
            if self.editing():
                self.update_editor_matches()
                if text:
                    self.find_step(False, keep=True)
            else:
                fc = d.view.get_find_controller()
                if text:
                    fc.search(text, self.web_opts(), 1000)
                    self.count_lbl.set_text("")
                    fc.count_matches(text, self.web_opts(), 1000)
                else:
                    fc.search_finish()
                    self.count_lbl.set_text("")

        def on_counted(self, d, n):
            if d is self.doc and not self.editing():
                self.count_lbl.set_text(f"{n} found" if n else "No results")

        def schedule_find_update(self):
            if not self.find_idle:
                self.find_idle = GLib.idle_add(self.do_find_update)

        def do_find_update(self):
            self.find_idle = 0
            if self.doc is not None and self.findbar.get_visible() and self.editing():
                self.update_editor_matches()
            return False

        def update_editor_matches(self):
            d = self.doc
            start, end = d.buffer.get_bounds()
            d.buffer.remove_tag(d.match_tag, start, end)
            text = self.find_entry.get_text()
            flash, self.flash = self.flash, None  # one-time message such as "Replaced 3"
            if not text:
                self.count_lbl.set_text(flash or "")
                return
            pat, err = self.compile_find(text)
            if err:
                self.count_lbl.set_text(err)
                return
            spans = find_spans(d.buffer.get_text(start, end, True), pat, MATCH_LIMIT + 1)
            for a, b in spans[:MATCH_LIMIT]:
                d.buffer.apply_tag(d.match_tag, d.buffer.get_iter_at_offset(a), d.buffer.get_iter_at_offset(b))
            if len(spans) > MATCH_LIMIT:
                summary = f"{MATCH_LIMIT}+ found"
            else:
                summary = f"{len(spans)} found" if spans else "No results"
            self.count_lbl.set_text(flash or summary)

        def find_step(self, backwards=False, keep=False):
            text = self.find_entry.get_text()
            d = self.doc
            if not text or d is None:
                return
            if not self.editing():
                fc = d.view.get_find_controller()
                fc.search_previous() if backwards else fc.search_next()
                return
            pat, err = self.compile_find(text)
            if err:
                self.count_lbl.set_text(err)
                return
            buf = d.buffer
            body = buf.get_text(*buf.get_bounds(), True)
            if buf.get_has_selection():
                sel_s, sel_e = (it.get_offset() for it in buf.get_selection_bounds())
            else:
                sel_s = sel_e = buf.get_iter_at_mark(buf.get_insert()).get_offset()
            if backwards:
                span = prev_span(body, pat, sel_s)
            else:
                span = next_span(body, pat, sel_s if keep else sel_e)
            if span:
                a, b = buf.get_iter_at_offset(span[0]), buf.get_iter_at_offset(span[1])
                buf.select_range(b, a)
                d.editor.scroll_to_iter(a, 0.15, False, 0, 0)

        def replace_current(self):
            d = self.doc
            if d is None or not self.editing():
                return
            text, buf = self.find_entry.get_text(), d.buffer
            if not text:
                return
            pat, err = self.compile_find(text)
            if err:
                self.count_lbl.set_text(err)
                return
            if buf.get_has_selection():
                a, b = buf.get_selection_bounds()
                so, eo = a.get_offset(), b.get_offset()
                m = pat.match(buf.get_text(*buf.get_bounds(), True), so)
                if m and m.end() == eo and eo > so:   # the selection is exactly a match
                    try:
                        new = self.replacement(m)
                    except (re.error, IndexError):
                        self.count_lbl.set_text("Invalid replacement")
                        return
                    buf.begin_user_action()
                    buf.delete(a, b)
                    buf.insert(a, new)
                    buf.end_user_action()
            self.find_step(False)
            self.schedule_find_update()

        def replace_all(self):
            d = self.doc
            if d is None or not self.editing():
                return
            text, buf = self.find_entry.get_text(), d.buffer
            if not text:
                return
            pat, err = self.compile_find(text)
            if err:
                self.count_lbl.set_text(err)
                return
            body = buf.get_text(*buf.get_bounds(), True)
            repl, regex = self.replace_entry.get_text(), self.regex_chk.get_active()
            try:
                plan = replace_plan(body, pat, repl, regex)
            except (re.error, IndexError):
                self.count_lbl.set_text("Invalid replacement")
                return
            if not plan:
                self.count_lbl.set_text("No results")
                return
            buf.begin_user_action()
            for so, eo, new in reversed(plan):  # back to front so earlier offsets stay valid
                a, b = buf.get_iter_at_offset(so), buf.get_iter_at_offset(eo)
                buf.delete(a, b)
                buf.insert(a, new)
            buf.end_user_action()
            self.flash = f"Replaced {len(plan)}"
            self.schedule_find_update()

        # ---------- background ----------
        def poll(self):  # auto-reload files that change on disk (never over unsaved edits)
            for d in list(self.docs):
                try:
                    if d.path and not d.dirty and os.path.getmtime(d.path) != d.mtime:
                        d.load(d.path)
                except OSError:
                    pass
            return True

        def open_dialog(self):
            dlg = Gtk.FileChooserDialog(title="Open Markdown", parent=self, action=Gtk.FileChooserAction.OPEN)
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
            dlg.set_select_multiple(True)
            for label, pats in (("Markdown, Word and OpenDocument", ("*.md", "*.markdown", "*.mdown", "*.docx", "*.odt")),
                                ("Markdown", ("*.md", "*.markdown", "*.mdown")),
                                ("Word / OpenDocument (converted to Markdown)", ("*.docx", "*.odt"))):
                flt = Gtk.FileFilter()
                flt.set_name(label)
                for pat in pats:
                    flt.add_pattern(pat)
                dlg.add_filter(flt)
            paths = dlg.get_filenames() if dlg.run() == Gtk.ResponseType.OK else []
            dlg.destroy()
            for p in paths:
                self.open_path(p)

    w = Viewer()
    w.show_all()
    if len(argv) > 1:
        for p in argv[1:]:
            w.open_path(p)
    else:
        w.open_dialog()
    if not w.docs:
        return
    Gtk.main()


def main():
    if sys.argv[1:2] in (["--convert"], ["-c"]):   # no window needed
        sys.exit(convert_cli(sys.argv[2:]))
    try:
        run(sys.argv)
    except Exception:
        import traceback
        err = traceback.format_exc()
        sys.stderr.write(err)
        try:
            d = os.path.join(os.path.expanduser("~/.cache"), "mdview")
            os.makedirs(d, exist_ok=True)
            with open(os.path.join(d, "last-error.log"), "w") as f:
                f.write(err)
        except OSError:
            pass
        sys.exit(1)


if __name__ == "__main__":
    main()
