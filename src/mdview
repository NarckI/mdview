    return any(h in f for h in MONO_HINTS)


def md_escape(s):
    """Escape characters that would otherwise be read as Markdown."""
    s = s.replace("\u00a0", " ").replace("\\", "\\\\")
    s = re.sub(r"([`*\[\]])", r"\\\1", s)
    s = re.sub(r"&(?=#?\w+;)", "&amp;", s).replace("<", "&lt;")
    return re.sub(r"(?<![A-Za-z0-9])_|_(?![A-Za-z0-9])", r"\\_", s)


def escape_line_start(line):
    """Stop a plain line from turning into a heading, list item, quote or rule."""
    m = re.match(r"^(\s*)(.*)$", line)
    lead, rest = m.group(1), m.group(2)
    if re.match(r"^(#{1,6}(\s|$)|[-+](\s|$)|>)", rest):
        rest = "\\" + rest
    elif re.match(r"^\d+[.)](\s|$)", rest):
        rest = re.sub(r"^(\d+)([.)])", r"\1\\\2", rest)
    elif re.match(r"^[-=_]{3,}\s*$", rest):
        rest = "\\" + rest
    return lead + rest


def escape_text_lines(text):
    return "\n".join(escape_line_start(ln) for ln in text.split("\n"))


def code_span(core):
    ticks = "`" * (max((len(m) for m in re.findall(r"`+", core)), default=0) + 1)
    pad = " " if core.startswith("`") or core.endswith("`") else ""
    return f"{ticks}{pad}{core}{pad}{ticks}"


def fence_block(text):
    longest = max((len(m) for m in re.findall(r"`+", text)), default=0)
    fence = "`" * max(3, longest + 1)
    return f"{fence}\n{text}\n{fence}"


def link_url(url):
    return url.replace(" ", "%20").replace("(", "%28").replace(")", "%29")


class Inline:
    """Collects formatted pieces of text and renders them as Markdown, merging neighbouring
    runs that share the same formatting so we get **a b** rather than **a** **b**."""

    def __init__(self):
        self.parts = []   # [key, text]; key is a format tuple, "raw" (already Markdown) or None (line break)

    def add(self, text, b=False, i=False, s=False, code=False, sup=False, sub=False, href=None):
        if not text:
            return
        key = (b, i, s, code, sup, sub, href)
        if self.parts and self.parts[-1][0] == key:
            self.parts[-1][1] += text
        else:
            self.parts.append([key, text])

    def raw(self, md):
        self.parts.append(["raw", md])

    def br(self):
        self.parts.append([None, ""])

    def all_code(self):
        texts = [k for k, t in self.parts if k not in (None, "raw") and t.strip()]
        return bool(texts) and all(k[3] for k in texts) and not any(k == "raw" for k, _ in self.parts)

    def render(self, bold=True):
        out = []
        for key, text in self.parts:
            if key is None:
                out.append("  \n")
                continue
            if key == "raw":
                out.append(text)
                continue
            b, i, s, code, sup, sub, href = key
            core = text.strip()
            if not core:
                out.append(" " if text else "")
                continue
            lead = " " if text[:1].isspace() else ""
            trail = " " if text[-1:].isspace() else ""
            core = core.replace("\u00a0", " ")
            body = code_span(core) if code else md_escape(core)
            if not code:
                if i:
                    body = f"*{body}*"
                if b and bold:
                    body = f"**{body}**"
                if s:
                    body = f"<del>{body}</del>"
            if sup:
                body = f"<sup>{body}</sup>"
            elif sub:
                body = f"<sub>{body}</sub>"
            if href:
                body = f"[{body}]({link_url(href)})"
            out.append(lead + body + trail)
        return "".join(out)


class Media:
    """Copies images out of the document into a folder next to the Markdown file."""

    def __init__(self, zf, media_dir=None, media_rel="media"):
        self.zf, self.dir, self.rel, self.done, self.used = zf, media_dir, media_rel, {}, set()
        self.names = set(zf.namelist())

    def add(self, member):
        if member in self.done:
            return self.done[member]
        if member not in self.names:
            return None
        name = re.sub(r"[^\w.\- ]", "_", posixpath.basename(member)) or "image"
        stem, ext = os.path.splitext(name)
        k = 1
        while name.lower() in self.used:
            k += 1
            name = f"{stem}_{k}{ext}"
        self.used.add(name.lower())
        if self.dir:
            os.makedirs(self.dir, exist_ok=True)
            with open(os.path.join(self.dir, name), "wb") as f:
                f.write(self.zf.read(member))
        self.done[member] = path = f"{urllib.parse.quote(self.rel)}/{urllib.parse.quote(name)}"
        return path


def alt_text(s):
    return re.sub(r"[\[\]\n\r]", " ", s or "").strip()


def render_table(rows):
    rows = [r for r in rows if r is not None]
    if not rows:
        return ""
    width = max(len(r) for r in rows)
    rows = [r + [""] * (width - len(r)) for r in rows]
    while width > 1 and all(not r[width - 1].strip() for r in rows):   # drop empty trailing columns
        rows = [r[:width - 1] for r in rows]
        width -= 1
    def line(cells):
        return "| " + " | ".join(c.strip() or " " for c in cells) + " |"
    out = [line(rows[0]), "| " + " | ".join(["---"] * width) + " |"]
    out += [line(r) for r in rows[1:]]
    return "\n".join(out)


def cell_markup(text):
    """Make rendered inline Markdown safe inside a pipe-table cell."""
    return text.replace("|", "&#124;").replace("  \n", "<br>").replace("\n", "<br>")


def render_blocks(blocks):
    """Turn the converters' block list into a Markdown document."""
    pieces = []   # [kind, text, separator-override]
    list_level = -1
    top_ordered = None
    prev = None
    for blk in blocks:
        kind = blk[0]
        if kind == "li":
            _, lvl, ordered, num, text = blk
            lvl = min(lvl, list_level + 1) if prev == "li" else 0
            list_level = lvl
            marker = f"{num}." if ordered else "-"
            sep = None
            if lvl == 0:
                if prev == "li" and top_ordered is not None and top_ordered != ordered:
                    sep = "\n\n"   # bullets next to numbers must not run together
                top_ordered = ordered
            indent = "    " * lvl
            cont = "\n" + indent + "    "
            text = cont.join(escape_line_start(ln) if k == 0 else ln for k, ln in enumerate(text.split("\n")))
            pieces.append(["li", f"{indent}{marker} {text}", sep])
        elif kind == "code":
            if prev == "code":
                pieces[-1][1] += "\n" + blk[1]
            else:
                pieces.append(["code", blk[1], None])
        elif kind == "quote":
            pieces.append(["quote", "\n".join("> " + escape_line_start(ln) if ln.strip() else ">"
                                              for ln in blk[1].split("\n")), None])
        elif kind == "h":
            pieces.append(["h", "#" * max(1, min(6, blk[1])) + " " + blk[2], None])
        elif kind == "table":
            md = render_table(blk[1])
            if md:
                pieces.append(["table", md, None])
        elif kind == "hr":
            pieces.append(["hr", "---", None])
        else:
            pieces.append(["p", escape_text_lines(blk[1]), None])
        prev = kind
    out = []
    for n, (kind, text, sep) in enumerate(pieces):
        if kind == "code":
            text = fence_block(text)
        if n:
            before = pieces[n - 1][0]
            if sep:
                out.append(sep)
            elif kind == "li" and before == "li":
                out.append("\n")
            elif kind == "quote" and before == "quote":
                out.append("\n>\n")
            else:
                out.append("\n\n")
        out.append(text)
    return re.sub(r"\n{3,}", "\n\n", "".join(out)).strip() + "\n"


# ---- .docx ----
W = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"
R = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}"
A = "{http://schemas.openxmlformats.org/drawingml/2006/main}"
WP = "{http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing}"
VML_IMAGEDATA = "{urn:schemas-microsoft-com:vml}imagedata"


def read_xml(zf, name, required=False):
    try:
        info = zf.getinfo(name)
    except KeyError:
        if required:
            raise ConvertError(f"Not a valid document: {name} is missing")
        return None
    if info.file_size > MAX_XML_BYTES:
        raise ConvertError(f"{name} is too large to convert")
    return ET.fromstring(zf.read(name))


def toggle_on(el):
    v = el.get(W + "val")
    return v is None or v.lower() not in ("0", "false", "off", "none")


class DocxConverter:
    def __init__(self, zf, media):
        self.zf, self.media = zf, media
        self.rels, self.raw_styles, self.style_cache = {}, {}, {}
        self.num_fmt, self.counters = {}, {}
        self.note_ids, self.note_order = {}, []

    # --- setup
    def load(self):
        rels = read_xml(self.zf, "word/_rels/document.xml.rels")
        if rels is not None:
            for r in rels:
                self.rels[r.get("Id")] = (r.get("Target", ""), r.get("TargetMode", ""))
        styles = read_xml(self.zf, "word/styles.xml")
        if styles is not None:
            for st in styles.iter(W + "style"):
                name_el, based = st.find(W + "name"), st.find(W + "basedOn")
                self.raw_styles[st.get(W + "styleId")] = (
                    name_el.get(W + "val", "") if name_el is not None else "",
                    based.get(W + "val") if based is not None else None, st)
        numbering = read_xml(self.zf, "word/numbering.xml")
        if numbering is not None:
            abstract = {}
            for an in numbering.findall(W + "abstractNum"):
                levels = {}
                for lvl in an.findall(W + "lvl"):
                    fmt, start = lvl.find(W + "numFmt"), lvl.find(W + "start")
                    levels[int(lvl.get(W + "ilvl", "0"))] = (
                        fmt.get(W + "val", "decimal") if fmt is not None else "decimal",
                        int(start.get(W + "val", "1")) if start is not None else 1)
                abstract[an.get(W + "abstractNumId")] = levels
            for n in numbering.findall(W + "num"):
                aid = n.find(W + "abstractNumId")
                if aid is not None:
                    for il, v in abstract.get(aid.get(W + "val"), {}).items():
                        self.num_fmt[(n.get(W + "numId"), il)] = v

    def style(self, sid, seen=()):
        """Resolved properties of a paragraph/character style, following basedOn."""
        if sid in self.style_cache:
            return self.style_cache[sid]
        base = dict(name="", b=False, i=False, s=False, mono=False, num=None, outline=None)
        if sid not in self.raw_styles or sid in seen:
            return base
        name, based, el = self.raw_styles[sid]
        info = dict(self.style(based, seen + (sid,))) if based else base
        info["name"] = name
        rpr = el.find(W + "rPr")
        if rpr is not None:
            info.update(self.run_flags(rpr, info))
        ppr = el.find(W + "pPr")
        if ppr is not None:
            num = ppr.find(W + "numPr")
            if num is not None:
                nid, il = num.find(W + "numId"), num.find(W + "ilvl")
                info["num"] = (nid.get(W + "val") if nid is not None else None,
                               int(il.get(W + "val", "0")) if il is not None else None)
            ol = ppr.find(W + "outlineLvl")
            if ol is not None:
                info["outline"] = int(ol.get(W + "val", "9"))
        self.style_cache[sid] = info
        return info

    def run_flags(self, rpr, cur):
        f = {k: cur[k] for k in ("b", "i", "s", "mono")}
        f["sup"] = f["sub"] = False
        if rpr is None:
            return f
        rs = rpr.find(W + "rStyle")
        if rs is not None:
            sinfo = self.style(rs.get(W + "val"))
            for k in ("b", "i", "s", "mono"):
                f[k] = f[k] or sinfo[k]
        for key, tag in (("b", "b"), ("i", "i")):
            el = rpr.find(W + tag)
            if el is not None:
                f[key] = toggle_on(el)
        for tag in ("strike", "dstrike"):
            el = rpr.find(W + tag)
            if el is not None:
                f["s"] = toggle_on(el)
        rf = rpr.find(W + "rFonts")
        if rf is not None:
            fonts = [rf.get(W + a) for a in ("ascii", "hAnsi", "cs", "eastAsia")]
            f["mono"] = any(is_mono(x) for x in fonts if x)
        va = rpr.find(W + "vertAlign")
        if va is not None:
            f["sup"], f["sub"] = va.get(W + "val") == "superscript", va.get(W + "val") == "subscript"
        return f

    # --- paragraphs
    def para_info(self, p):
        ppr = p.find(W + "pPr")
        sid, num, outline = None, None, None
        if ppr is not None:
            ps = ppr.find(W + "pStyle")
            sid = ps.get(W + "val") if ps is not None else None
            n = ppr.find(W + "numPr")
            if n is not None:
                nid, il = n.find(W + "numId"), n.find(W + "ilvl")
                num = (nid.get(W + "val") if nid is not None else None,
                       int(il.get(W + "val", "0")) if il is not None else None)
            ol = ppr.find(W + "outlineLvl")
            if ol is not None:
                outline = int(ol.get(W + "val", "9"))
        sinfo = self.style(sid) if sid else dict(name="", b=False, i=False, s=False, mono=False, num=None, outline=None)
        name = sinfo["name"].lower()
        level = None
        m = re.match(r"heading\s*(\d)", name)
        if m:
            level = int(m.group(1))
        elif name == "title":
            level = 1
        elif (outline if outline is not None else sinfo["outline"]) not in (None, 9):
            level = (outline if outline is not None else sinfo["outline"]) + 1
        if num is None and sinfo["num"] is not None:
            num = sinfo["num"]
        elif num is not None and sinfo["num"] is not None:
            num = (num[0] if num[0] is not None else sinfo["num"][0], num[1] if num[1] is not None else sinfo["num"][1])
        lm = re.match(r"list (bullet|number)\s*(\d?)", name)
        if lm and not level:
            depth = int(lm.group(2) or 1) - 1   # "List Bullet 2" is the second level
            if num is None:
                num = ("style:" + lm.group(1), depth)
            elif num[1] in (None, 0) and depth:
                num = (num[0], depth)
        return sinfo, name, level, num

    def inline_of(self, p, sinfo, heading=False):
        inline = Inline()
        base = {k: sinfo[k] for k in ("b", "i", "s", "mono")}
        if heading:
            base = dict(b=False, i=False, s=False, mono=False)
        self.runs(p, inline, base, None, {"active": False, "instr": "", "href": None})
        return inline

    def plain(self, p):
        out = []
        for r in p.iter(W + "r"):
            for c in r:
                if c.tag == W + "t":
                    out.append(c.text or "")
                elif c.tag == W + "tab":
                    out.append("    ")
                elif c.tag in (W + "br", W + "cr") and c.get(W + "type") not in ("page", "column"):
                    out.append("\n")
        return "".join(out).replace("\u00a0", " ")

    def paragraph(self, p):
        sinfo, name, level, num = self.para_info(p)
        if re.match(r"(toc \d|table of contents|toc heading)", name) or name in ("toc heading", "contents heading"):
            return []
        inline = self.inline_of(p, sinfo, heading=bool(level))
        if level:
            text = re.sub(r"\s+", " ", inline.render(bold=False)).strip()
            return [("h", level, text)] if text else []
        if num is not None and num[0] not in (None, "0"):
            text = inline.render().strip()
            if not text:
                return []
            ordered, number = self.list_kind(num)
            return [("li", num[1] or 0, ordered, number, text)]
        if inline.all_code() or any(h in name for h in CODE_STYLE_HINTS) or sinfo["mono"]:
            text = self.plain(p)
            if text.strip():
                return [("code", text.rstrip())]
        text = inline.render().strip()
        if not text:
            return []
        if is_quote_style(name):
            return [("quote", text)]
        return [("p", text)]

    def list_kind(self, num):
        nid, il = num[0], num[1] or 0
        if nid.startswith("style:"):
            return nid == "style:number", self.next_number(nid, il, 1)
        fmt, start = self.num_fmt.get((nid, il), ("bullet", 1))
        if fmt in ("bullet", "none"):
            return False, 0
        return True, self.next_number(nid, il, start)

    def next_number(self, nid, il, start):
        c = self.counters.setdefault(nid, {})
        c[il] = c.get(il, start - 1) + 1
        for k in [k for k in c if k > il]:
            del c[k]
        return c[il]

    # --- runs
    def runs(self, parent, inline, base, href, st):
        for ch in parent:
            t = ch.tag
            if t == W + "r":
                self.run(ch, inline, base, href, st)
            elif t == W + "hyperlink":
                target = href
                rid = ch.get(R + "id")
                if rid and rid in self.rels and self.rels[rid][1] == "External":
                    target = self.rels[rid][0]
                self.runs(ch, inline, base, target, st)
            elif t == W + "fldSimple":
                m = re.search(r'HYPERLINK\s+"([^"]+)"', ch.get(W + "instr", ""))
                self.runs(ch, inline, base, m.group(1) if m and "\\l" not in ch.get(W + "instr", "") else href, st)
            elif t in (W + "ins", W + "smartTag", W + "customXml", W + "bdo", W + "dir", W + "moveTo"):
                self.runs(ch, inline, base, href, st)
            elif t == W + "sdt":
                content = ch.find(W + "sdtContent")
                if content is not None:
                    self.runs(content, inline, base, href, st)

    def run(self, r, inline, base, href, st):
        f = self.run_flags(r.find(W + "rPr"), base)
        link = href or st["href"]
        for c in r:
            t = c.tag
            if t == W + "t":
                if not st["active"]:
                    inline.add(c.text or "", f["b"], f["i"], f["s"], f["mono"], f["sup"], f["sub"], link)
            elif t == W + "instrText":
                st["instr"] += c.text or ""
            elif t == W + "fldChar":
                kind = c.get(W + "fldCharType")
                if kind == "begin":
                    st["active"], st["instr"] = True, ""
                elif kind == "separate":
                    st["active"] = False
                    m = re.search(r'HYPERLINK\s+"([^"]+)"', st["instr"])
                    st["href"] = m.group(1) if m and "\\l" not in st["instr"] else None
                elif kind == "end":
                    st["active"], st["href"] = False, None
            elif t == W + "tab":
                inline.add(" ", f["b"], f["i"], f["s"], f["mono"])
            elif t in (W + "br", W + "cr"):
                if c.get(W + "type") not in ("page", "column"):
                    inline.br()
            elif t == W + "noBreakHyphen":
                inline.add("-", f["b"], f["i"], f["s"], f["mono"])
            elif t == W + "drawing":
                self.image(c, inline)
            elif t == W + "pict":
                for im in c.iter(VML_IMAGEDATA):
                    self.add_image(im.get(R + "id"), "", inline)
            elif t in (W + "footnoteReference", W + "endnoteReference"):
                kind = "footnote" if t == W + "footnoteReference" else "endnote"
                key = (kind, c.get(W + "id"))
                if key not in self.note_ids:
                    self.note_ids[key] = len(self.note_ids) + 1
                    self.note_order.append(key)
                inline.add(str(self.note_ids[key]), sup=True)

    def image(self, drawing, inline):
        alt = ""
        for dp in drawing.iter(WP + "docPr"):
            alt = dp.get("descr") or dp.get("title") or ""
            break
        for blip in drawing.iter(A + "blip"):
            self.add_image(blip.get(R + "embed"), alt, inline)

    def add_image(self, rid, alt, inline):
        rel = self.rels.get(rid)
        if not rel or rel[1] == "External":
            return
        target = rel[0].lstrip("/") if rel[0].startswith("/") else posixpath.normpath("word/" + rel[0])
        path = self.media.add(target)
        if path:
            inline.raw(f"![{alt_text(alt)}]({path})")

    # --- tables
    def cell_text(self, tc, bold=True):
        parts = []
        for ch in tc:
            if ch.tag == W + "p":
                sinfo, name, level, num = self.para_info(ch)
                text = self.inline_of(ch, sinfo, heading=bool(level)).render(bold=bold).strip()
                if text:
                    parts.append(("• " if num is not None and num[0] not in (None, "0") else "") + text)
            elif ch.tag == W + "tbl":
                text = " ".join(self.plain(p).strip() for p in ch.iter(W + "p") if self.plain(p).strip())
                if text:
                    parts.append(md_escape(text))
        return cell_markup("<br>".join(parts))

    def table(self, tbl):
        rows = []
        for tr in tbl.findall(W + "tr"):
            cells = []
            for tc in tr.findall(W + "tc"):
                tcpr = tc.find(W + "tcPr")
                span, vmerge_cont = 1, False
                if tcpr is not None:
                    gs = tcpr.find(W + "gridSpan")
                    if gs is not None:
                        span = max(1, int(gs.get(W + "val", "1")))
                    vm = tcpr.find(W + "vMerge")
                    vmerge_cont = vm is not None and vm.get(W + "val") != "restart"
                cells.append("" if vmerge_cont else self.cell_text(tc, bold=bool(rows)))   # header row is bold anyway
                cells.extend([""] * (span - 1))
            rows.append(cells)
        return ("table", rows)

    def walk(self, parent):
        blocks = []
        for el in parent:
            if el.tag == W + "p":
                blocks += self.paragraph(el)
            elif el.tag == W + "tbl":
                blocks.append(self.table(el))
            elif el.tag == W + "sdt":
                content = el.find(W + "sdtContent")
                if content is not None:
                    blocks += self.walk(content)
        return blocks

    def notes(self):
        blocks = []
        roots = {}
        for kind, fname in (("footnote", "word/footnotes.xml"), ("endnote", "word/endnotes.xml")):
            roots[kind] = read_xml(self.zf, fname)
        for key in self.note_order:
            kind, nid = key
            root, texts = roots.get(kind), []
            if root is not None:
                for note in root.findall(W + kind):
                    if note.get(W + "id") == nid:
                        for p in note.iter(W + "p"):
                            sinfo, _, _, _ = self.para_info(p)
                            t = self.inline_of(p, sinfo).render().strip()
                            if t:
                                texts.append(t)
            blocks.append(("li", 0, True, self.note_ids[key], " ".join(texts) or "(empty note)"))
        return ([("hr",)] + blocks) if blocks else []

    def convert(self):
        self.load()
        doc = read_xml(self.zf, "word/document.xml", required=True)
        body = doc.find(W + "body")
        if body is None:
            raise ConvertError("Not a valid Word document (no body)")
        return render_blocks(self.walk(body) + self.notes())


# ---- .odt ----
OFFICE = "{urn:oasis:names:tc:opendocument:xmlns:office:1.0}"
TEXT = "{urn:oasis:names:tc:opendocument:xmlns:text:1.0}"
TABLE = "{urn:oasis:names:tc:opendocument:xmlns:table:1.0}"
DRAW = "{urn:oasis:names:tc:opendocument:xmlns:drawing:1.0}"
STYLE = "{urn:oasis:names:tc:opendocument:xmlns:style:1.0}"
FO = "{urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0}"
SVG = "{urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0}"
XLINK = "{http://www.w3.org/1999/xlink}"


class OdtConverter:
    def __init__(self, zf, media):
        self.zf, self.media = zf, media
        self.fonts_mono, self.styles, self.list_styles = set(), {}, {}
        self.notes, self.style_cache = [], {}

    def load(self, *roots):
        for root in roots:
            if root is None:
                continue
            for ff in root.iter(STYLE + "font-face"):
                fam = ff.get(SVG + "font-family", "")
                if ff.get(STYLE + "font-pitch") == "fixed" or is_mono(fam) or is_mono(ff.get(STYLE + "name")):
                    self.fonts_mono.add(ff.get(STYLE + "name"))
            for st in root.iter(STYLE + "style"):
                self.styles[st.get(STYLE + "name")] = st
            for ls in root.iter(TEXT + "list-style"):
                levels = {}
                for lv in ls:
                    n = int(lv.get(TEXT + "level", "1"))
                    if lv.tag == TEXT + "list-level-style-number" and lv.get(STYLE + "num-format"):
                        levels[n] = "number"
                    else:
                        levels[n] = "bullet"
                self.list_styles[ls.get(STYLE + "name")] = levels

    def style(self, name, seen=()):
        """Resolved text properties and the chain of style names for a style."""
        if name in self.style_cache:
            return self.style_cache[name]
        info = dict(b=False, i=False, s=False, mono=False, sup=False, sub=False, names=[])
        st = self.styles.get(name)
        if st is None or name in seen:
            return info
        parent = st.get(STYLE + "parent-style-name")
        if parent:
            info = dict(self.style(parent, seen + (name,)))
            info["names"] = list(info["names"])
        info["names"].append(name.replace("_20_", " ").lower())
        tp = st.find(STYLE + "text-properties")
        if tp is not None:
            w, it = tp.get(FO + "font-weight"), tp.get(FO + "font-style")
            if w is not None:
                info["b"] = w in ("bold", "600", "700", "800", "900")
            if it is not None:
                info["i"] = it in ("italic", "oblique")
            ls = tp.get(STYLE + "text-line-through-style")
            if ls is not None:
                info["s"] = ls != "none"
            pos = tp.get(STYLE + "text-position")
            if pos is not None:
                first = pos.split()[0]
                info["sup"] = first == "super" or (first.rstrip("%").lstrip("+").replace(".", "", 1).isdigit()
                                                   and not first.startswith("-") and first.rstrip("%") not in ("0", ""))
                info["sub"] = first == "sub" or first.startswith("-")
            fonts = [tp.get(STYLE + "font-name"), tp.get(FO + "font-family")]
            if any(f and (f in self.fonts_mono or is_mono(f)) for f in fonts):
                info["mono"] = True
            elif any(fonts):
                info["mono"] = False
        self.style_cache[name] = info
        return info

    # --- inline content
    def walk_inline(self, el, inline, fmt, href):
        if el.text:
            self.emit(el.text, inline, fmt, href)
        for ch in el:
            t = ch.tag
            if t == TEXT + "span":
                sf = self.style(ch.get(TEXT + "style-name"))
                f2 = dict(fmt)
                for k in ("b", "i", "s", "sup", "sub"):
                    f2[k] = fmt[k] or sf[k] if k in ("b", "i", "s") else sf[k]
                f2["mono"] = sf["mono"] or fmt["mono"]
                self.walk_inline(ch, inline, f2, href)
            elif t == TEXT + "a":
                self.walk_inline(ch, inline, fmt, ch.get(XLINK + "href") or href)
            elif t == TEXT + "s":
                self.emit(" " * int(ch.get(TEXT + "c", "1")), inline, fmt, href)
            elif t == TEXT + "tab":
                self.emit(" ", inline, fmt, href)
            elif t == TEXT + "line-break":
                inline.br()
            elif t == DRAW + "frame":
                self.frame(ch, inline)
            elif t == TEXT + "note":
                body = ch.find(TEXT + "note-body")
                texts = []
                if body is not None:
                    for p in body:
                        if p.tag in (TEXT + "p", TEXT + "h"):
                            tx = self.para_text(p)
                            if tx:
                                texts.append(tx)
                self.notes.append(" ".join(texts) or "(empty note)")
                inline.add(str(len(self.notes)), sup=True)
            elif t in (TEXT + "bookmark", TEXT + "bookmark-start", TEXT + "bookmark-end", TEXT + "soft-page-break",
                       TEXT + "note-citation", TEXT + "number", TEXT + "reference-mark", TEXT + "reference-mark-start",
                       TEXT + "reference-mark-end", TEXT + "change", TEXT + "change-start", TEXT + "change-end"):
                pass
            else:   # unknown wrapper (e.g. text:meta, text:bookmark-ref): keep its text
                self.walk_inline(ch, inline, fmt, href)
            if ch.tail:
                self.emit(ch.tail, inline, fmt, href)

    def emit(self, text, inline, f, href):
        inline.add(text, f["b"], f["i"], f["s"], f["mono"], f["sup"], f["sub"], href)

    def frame(self, fr, inline):
        alt = ""
        for tag in ("desc", "title"):
            e = fr.find(SVG + tag)
            if e is not None and e.text:
                alt = e.text
                break
        for img in fr.iter(DRAW + "image"):
            href = (img.get(XLINK + "href") or "").lstrip("./")
            if href.startswith("http"):
                inline.raw(f"![{alt_text(alt)}]({link_url(href)})")
                continue
            path = self.media.add(href)
            if path:
                inline.raw(f"![{alt_text(alt)}]({path})")

    def base_fmt(self, el, heading=False):
        info = self.style(el.get(TEXT + "style-name"))
        f = dict(b=info["b"], i=info["i"], s=info["s"], mono=info["mono"], sup=False, sub=False)
        if heading:
            f.update(b=False, i=False, s=False, mono=False)
        return f, info

    def para_text(self, p, heading=False, bold=True):
        f, _ = self.base_fmt(p, heading)
        inline = Inline()
        self.walk_inline(p, inline, f, None)
        return inline.render(bold=bold and not heading).strip()

    def plain(self, p):
        out = []

        def rec(el):
            if el.text:
                out.append(el.text)
            for ch in el:
                if ch.tag == TEXT + "s":
                    out.append(" " * int(ch.get(TEXT + "c", "1")))
                elif ch.tag == TEXT + "tab":
                    out.append("    ")
                elif ch.tag == TEXT + "line-break":
                    out.append("\n")
                elif ch.tag in (TEXT + "note", DRAW + "frame"):
                    pass
                else:
                    rec(ch)
                if ch.tail:
                    out.append(ch.tail)
        rec(p)
        return "".join(out).replace("\u00a0", " ")

    # --- blocks
    def para(self, p):
        f, info = self.base_fmt(p)
        names = info["names"]
        inline = Inline()
        self.walk_inline(p, inline, f, None)
        if inline.all_code() or info["mono"] or any(h in n for n in names for h in CODE_STYLE_HINTS):
            text = self.plain(p)
            if text.strip():
                return [("code", text.rstrip())]
        text = inline.render().strip()
        if not text:
            return []
        if any(is_quote_style(n) for n in names):
            return [("quote", text)]
        return [("p", text)]

    def list_blocks(self, el, depth, lstyle):
        sname = el.get(TEXT + "style-name") or lstyle
        kind = self.list_styles.get(sname, {}).get(depth + 1, "bullet")
        n = 1
        out = []
        for item in el:
            if item.tag not in (TEXT + "list-item", TEXT + "list-header"):
                continue
            if item.get(TEXT + "start-value"):
                n = int(item.get(TEXT + "start-value"))
            texts, subs = [], []
            for ch in item:
                if ch.tag in (TEXT + "p", TEXT + "h"):
                    t = self.para_text(ch)
                    if t:
                        texts.append(t)
                elif ch.tag == TEXT + "list":
                    subs += self.list_blocks(ch, depth + 1, sname)
            if texts:
                out.append(("li", depth, kind == "number", n, "  \n".join(texts)))
                n += 1
            out += subs
        return out

    def cell_text(self, cell, bold=True):
        parts = []
        for ch in cell:
            if ch.tag in (TEXT + "p", TEXT + "h"):
                t = self.para_text(ch, bold=bold)
                if t:
                    parts.append(t)
            elif ch.tag == TEXT + "list":
                for blk in self.list_blocks(ch, 0, None):
                    parts.append("• " + blk[4])
            elif ch.tag == TABLE + "table":
                t = " ".join(self.plain(p).strip() for p in ch.iter(TEXT + "p") if self.plain(p).strip())
                if t:
                    parts.append(md_escape(t))
        return cell_markup("<br>".join(parts))

    def table(self, tbl):
        rows = []

        def collect(parent):
            for ch in parent:
                if ch.tag == TABLE + "table-row":
                    cells = []
                    for c in ch:
                        if c.tag == TABLE + "table-cell":
                            text = self.cell_text(c, bold=bool(rows))
                            rep = min(int(c.get(TABLE + "number-columns-repeated", "1")), 50)
                            span = int(c.get(TABLE + "number-columns-spanned", "1"))
                            for _ in range(rep):
                                cells.append(text)
                                cells.extend([""] * (span - 1))
                        elif c.tag == TABLE + "covered-table-cell":
                            cells.append("")
                    rows.append(cells)
                elif ch.tag in (TABLE + "table-header-rows", TABLE + "table-row-group", TABLE + "table-rows"):
                    collect(ch)
        collect(tbl)
        return ("table", rows)

    def walk(self, parent, lstyle=None):
        blocks = []
        for el in parent:
            t = el.tag
            if t == TEXT + "h":
                text = re.sub(r"\s+", " ", self.para_text(el, heading=True)).strip()
                if text:
                    blocks.append(("h", int(el.get(TEXT + "outline-level", "1") or 1), text))
            elif t == TEXT + "p":
                blocks += self.para(el)
            elif t == TEXT + "list":
                blocks += self.list_blocks(el, 0, lstyle)
            elif t == TABLE + "table":
                blocks.append(self.table(el))
            elif t == TEXT + "section":
                blocks += self.walk(el, lstyle)
        return blocks

    def convert(self):
        content = read_xml(self.zf, "content.xml", required=True)
        self.load(read_xml(self.zf, "styles.xml"), content)
        body = content.find(OFFICE + "body")
        text = body.find(OFFICE + "text") if body is not None else None
        if text is None:
            raise ConvertError("Not a valid OpenDocument text file")
        blocks = self.walk(text)
        if self.notes:
            blocks.append(("hr",))
            blocks += [("li", 0, True, n, t) for n, t in enumerate(self.notes, 1)]
        return render_blocks(blocks)


def convert_to_markdown(src, media_dir=None, media_rel="media"):
    """Markdown text for a .docx or .odt file. Images are copied into media_dir (if given) and
    referenced as media_rel/<name>."""
    ext = os.path.splitext(src)[1].lower()
    if ext not in CONVERT_EXTS:
        raise ConvertError("Only .docx and .odt files can be converted")
    try:
        with zipfile.ZipFile(src) as zf:
            media = Media(zf, media_dir, media_rel)
            conv = DocxConverter(zf, media) if ext == ".docx" else OdtConverter(zf, media)
            return conv.convert()
    except zipfile.BadZipFile:
        raise ConvertError(f"{os.path.basename(src)} is not a valid {ext[1:]} file")
    except ET.ParseError as e:
        raise ConvertError(f"The document's XML could not be read: {e}")
    except OSError as e:
        raise ConvertError(str(e))


def convert_file(src, dest=None):
    """Convert src next to itself (or to dest). Returns (dest_path, number_of_images)."""
    stem = os.path.splitext(os.path.basename(src))[0]
    dest = os.path.abspath(dest or os.path.join(os.path.dirname(os.path.abspath(src)), stem + ".md"))
    media_name = os.path.splitext(os.path.basename(dest))[0] + "_media"
    media_dir = os.path.join(os.path.dirname(dest), media_name)
    existed = os.path.isdir(media_dir)
    text = convert_to_markdown(src, media_dir, media_name)
    try:
        with open(dest, "w", encoding="utf-8") as f:
            f.write(text)
    except OSError as e:
        raise ConvertError(f"Could not write {dest}: {e}")
    count = len(os.listdir(media_dir)) if os.path.isdir(media_dir) else 0
    if not existed and count == 0 and os.path.isdir(media_dir):
        os.rmdir(media_dir)
    return dest, count


def convert_cli(args):
    """mdview --convert INPUT.docx|.odt [-o OUTPUT.md | -o -] [--force]"""
    src, out, force = None, None, False
    it = iter(args)
    for a in it:
        if a in ("-o", "--output"):
            out = next(it, None)
        elif a in ("-f", "--force"):
            force = True
        elif src is None:
            src = a
    if not src or out == "":
        sys.stderr.write(convert_cli.__doc__.strip() + "\n")
        return 2
    try:
        if out == "-":
            sys.stdout.write(convert_to_markdown(src, None, "media"))
            return 0
        dest = os.path.abspath(out) if out else os.path.join(
            os.path.dirname(os.path.abspath(src)), os.path.splitext(os.path.basename(src))[0] + ".md")
        if os.path.exists(dest) and not force:
            sys.stderr.write(f"{dest} already exists (use --force to overwrite or -o to choose another name)\n")
            return 1
        dest, count = convert_file(src, dest)
    except ConvertError as e:
        sys.stderr.write(f"mdview: {e}\n")
        return 1
    print(f"Wrote {dest}" + (f" and {count} image(s)" if count else ""))
    return 0


def run(argv):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    try:
        gi.require_version("WebKit2", "4.1")
    except ValueError:
        gi.require_version("WebKit2", "4.0")
    from gi.repository import Gdk, Gio, GLib, Gtk, Pango, WebKit2

    LABELS = {"auto": "◐ Auto", "light": "☀ Light", "dark": "🌙 Dark"}
    CTRL, SHIFT, ALT = Gdk.ModifierType.CONTROL_MASK, Gdk.ModifierType.SHIFT_MASK, Gdk.ModifierType.MOD1_MASK

    def iter_at_line(buf, n):
        r = buf.get_iter_at_line(n)
        return r[1] if isinstance(r, tuple) else r

    class Doc:
        """One open file: its editor, live preview, undo history and scroll-sync state."""

        def __init__(self, win):
            self.win = win
            self.path, self.mtime = None, 0
            self.dirty = self.loading = self.undoing = False
            self.preview_id = self.hl_id = 0
            self.lock, self.lock_until = None, 0.0
            self.hist = UndoStack()
            self.large, self.ready, self.text_cache = False, True, ""   # large-file mode: buffer loads on demand
            self.render_gen, self.shell_ready, self.queue = 0, False, []
            self.back, self.fwd = [], []   # files visited before / after this one in this tab
            self.tab_box = self.tab_label = None

            self.editor = Gtk.TextView()
            self.editor.set_monospace(True)
            self.editor.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            self.editor.set_left_margin(12)
            self.editor.set_right_margin(12)
            self.editor.set_top_margin(10)
            self.editor.set_bottom_margin(10)
            self.buffer = self.editor.get_buffer()
            for name in SYN_TAGS:
                self.buffer.create_tag(name)
            self.buffer.get_tag_table().lookup("md-h").set_property("weight", Pango.Weight.BOLD)
            self.buffer.get_tag_table().lookup("md-marker").set_property("weight", Pango.Weight.BOLD)
            self.buffer.get_tag_table().lookup("md-bold").set_property("weight", Pango.Weight.BOLD)
            self.buffer.get_tag_table().lookup("md-italic").set_property("style", Pango.Style.ITALIC)
            # created last so a find match is drawn on top of the syntax colours
            self.match_tag = self.buffer.create_tag("match", background="#f2cc60", foreground="#000000")
            self.apply_palette(win.is_dark())
            self.buffer.connect("changed", self.on_changed)
            self.buffer.connect("begin-user-action", lambda b: self.hist.begin())
            self.buffer.connect("end-user-action", lambda b: self.hist.end(time.monotonic()))
            self.buffer.connect_after("insert-text", self.on_insert)
            self.buffer.connect("delete-range", self.on_delete)

            self.editor_sw = Gtk.ScrolledWindow()
            self.editor_sw.add(self.editor)
            self.editor_sw.set_no_show_all(True)
            self.editor_sw.get_vadjustment().connect("value-changed", self.on_editor_scroll)

            ucm = WebKit2.UserContentManager()
            ucm.register_script_message_handler("scroll")
            ucm.connect("script-message-received::scroll", self.on_preview_scroll)
            self.view = WebKit2.WebView.new_with_user_content_manager(ucm)
            self.view.connect("decide-policy", self.on_policy)
            self.view.connect("load-changed", self.on_load_changed)
            self.view.connect("button-press-event", win.on_mouse)   # mouse back/forward buttons
            self.view.get_find_controller().connect("counted-matches", lambda fc, n: win.on_counted(self, n))
            self.paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
            self.paned.pack1(self.editor_sw, True, False)
            self.paned.pack2(self.view, True, True)

        def dispose(self):
            for sid in (self.preview_id, self.hl_id):
                if sid:
                    GLib.source_remove(sid)
            self.preview_id = self.hl_id = 0
            self.render_gen += 1   # stops a background render of a large file

        # ---------- editor colouring ----------
        def apply_palette(self, dark):
            table = self.buffer.get_tag_table()
            for name, color in PALETTE[dark].items():
                table.lookup(name).set_property("foreground", color)

        def run_highlight(self):
            self.hl_id = 0
            buf = self.buffer
            start, end = buf.get_bounds()
            for name in SYN_TAGS:
                buf.remove_tag_by_name(name, start, end)
            text = buf.get_text(start, end, True)
            if len(text) <= HL_MAX_CHARS:
                for name, a, b in md_spans(text)[:30000]:
                    buf.apply_tag_by_name(name, buf.get_iter_at_offset(a), buf.get_iter_at_offset(b))
            return False

        # ---------- editing, undo and redo ----------
        def on_insert(self, buf, it, text, length):
            if not (self.loading or self.undoing):   # `it` is already past the inserted text
                self.hist.record("ins", it.get_offset() - len(text), text, time.monotonic())

        def on_delete(self, buf, start, end):
            if not (self.loading or self.undoing):
                self.hist.record("del", start.get_offset(), buf.get_text(start, end, True), time.monotonic())

        def on_changed(self, buf):
            if self.loading:
                return
            self.dirty = True
            self.update_label()
            self.win.on_doc_edited(self)
            if self.large:   # re-rendering / re-colouring a huge file on every pause would freeze the UI
                return
            if self.preview_id:
                GLib.source_remove(self.preview_id)
            self.preview_id = GLib.timeout_add(250, self.live_preview)
            if self.hl_id:
                GLib.source_remove(self.hl_id)
            self.hl_id = GLib.timeout_add(150, self.run_highlight)

        def step_history(self, undo):
            group = self.hist.pop_undo() if undo else self.hist.pop_redo()
            if group is None:
                return
            buf, pos = self.buffer, 0
            self.undoing = True
            try:
                for kind, off, text in (reversed(group) if undo else group):
                    if (kind == "ins") != undo:       # undoing a delete / redoing an insert
                        buf.insert(buf.get_iter_at_offset(off), text)
                        pos = off + len(text)
                    else:
                        buf.delete(buf.get_iter_at_offset(off), buf.get_iter_at_offset(off + len(text)))
                        pos = off
            finally:
                self.undoing = False
            it = buf.get_iter_at_offset(pos)
            buf.place_cursor(it)
            self.editor.scroll_to_iter(it, 0.1, False, 0, 0)
            self.dirty = not self.hist.is_clean()
            self.update_label()

        def live_preview(self):  # swap the rendered body in place so scroll position is kept
            self.preview_id = 0
            start, end = self.buffer.get_bounds()
            text = self.buffer.get_text(start, end, True)
            js = ("var a=document.querySelector('article'); if(a){a.innerHTML=%s;%s}"
                  % (json.dumps(render_body(text)), tag_call(text)))
            self.view.run_javascript(js, None, None, None)
            return False

        def update_label(self):
            self.win.refresh_tab(self)

        def save(self):
            if not self.path or not self.ready:
                return
            start, end = self.buffer.get_bounds()
            text = self.buffer.get_text(start, end, True)
            try:
                with open(self.path, "w", encoding="utf-8") as f:
                    f.write(text)
                self.mtime = os.path.getmtime(self.path)
            except OSError as e:
                self.win.message(f"Could not save: {e}")
                return
            self.dirty = False
            self.hist.mark_clean()
            self.update_label()
            if self.large:
                self.start_render(text)

        # ---------- loading ----------
        def load(self, path):
            path = os.path.abspath(path)
            try:
                with open(path, encoding="utf-8", errors="replace") as f:
                    text = f.read()
                self.mtime = os.path.getmtime(path)
            except OSError as e:
                text, self.mtime = f"# Cannot open file\n\n{e}", 0
            self.path = path
            for sid in (self.preview_id, self.hl_id):
                if sid:
                    GLib.source_remove(sid)
            self.preview_id = self.hl_id = 0
            self.large = len(text) > LARGE_CHARS
            if self.large:   # keep the text aside; the editor only gets it if Edit is switched on
                self.text_cache, self.ready = text, False
                self.loading = True
                self.buffer.set_text("")
                self.loading = False
                self.hist.clear()
                self.dirty = False
                self.update_label()
                self.start_render(text)
                if self.editor_sw.get_visible():
                    self.ensure_buffer()
                return
            self.text_cache, self.ready = "", True
            self.loading = True
            self.buffer.set_text(text)
            self.loading = False
            self.hist.clear()
            self.dirty = False
            self.update_label()
            self.view.load_html(render(text, os.path.basename(path), self.win.theme),
                                Gio.File.new_for_path(path).get_uri())
            self.run_highlight()

        def ensure_buffer(self):
            """Large files: put the text into the editor the first time it is needed."""
            if self.ready:
                return
            self.loading = True
            self.buffer.set_text(self.text_cache)
            self.loading = False
            self.hist.clear()
            self.dirty = False
            self.ready, self.text_cache = True, ""
            self.update_label()

        def start_render(self, text):
            """Render in a worker thread, one chunk at a time, so the window stays usable."""
            self.render_gen += 1
            gen = self.render_gen
            self.shell_ready, self.queue = False, []
            self.view.load_html(render_shell(os.path.basename(self.path), self.win.theme),
                                Gio.File.new_for_path(self.path).get_uri())
            chunks = split_chunks(text)

            def work():
                for i, chunk in enumerate(chunks, 1):
                    if gen != self.render_gen:
                        return
                    try:
                        body = render_body(chunk)
                    except Exception as e:   # keep going rather than leave the page half empty
                        body = "<pre>%s</pre>" % htmlmod.escape(str(e))
                    GLib.idle_add(self.on_chunk, gen, body, i, len(chunks))
            threading.Thread(target=work, daemon=True).start()

        def on_chunk(self, gen, body, i, n):
            if gen == self.render_gen:
                self.queue.append((body, i, n))
                self.flush_chunks()
            return False

        def flush_chunks(self):
            if not self.shell_ready:
                return
            for body, i, n in self.queue:
                self.view.run_javascript("mdAppend(%s,%d,%d)" % (json.dumps(body), i, n), None, None, None)
            self.queue = []

        def on_load_changed(self, view, event):
            if self.large and event == WebKit2.LoadEvent.FINISHED and not self.shell_ready:
                self.shell_ready = True
                self.flush_chunks()

        def navigate(self, path):
            """Follow a link inside this tab, remembering where we came from."""
            if not self.win.confirm_discard(self):
                return
            if self.path:
                self.back.append(self.path)
            self.fwd = []
            self.load(path)
            self.win.update_nav()

        def go(self, back):
            """Back / forward through the files visited in this tab."""
            stack, other = (self.back, self.fwd) if back else (self.fwd, self.back)
            if not stack or not self.win.confirm_discard(self):
                return
            other.append(self.path)
            self.load(stack.pop())
            self.win.update_nav()

        def on_policy(self, view, decision, dtype):
            if dtype != WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
                return False
            uri = decision.get_navigation_action().get_request().get_uri()
            base = Gio.File.new_for_path(self.path).get_uri() if self.path else ""
            if uri.startswith("about:") or uri == base or uri.startswith(base + "#"):
                return False
            if uri.startswith("file://"):
                p = GLib.filename_from_uri(uri.split("#")[0])[0]
                if p.lower().endswith((".md", ".markdown")):
                    decision.ignore()
                    act = decision.get_navigation_action()
                    newtab = act.get_mouse_button() == 2 or bool(act.get_modifiers() & CTRL)
                    if newtab:   # middle-click or Ctrl+click
                        self.win.open_path(p)
                    else:
                        self.navigate(p)
                    return True
            decision.ignore()
            Gio.AppInfo.launch_default_for_uri(uri, None)
            return True

        # ---------- synchronized scrolling (line based, see mdTag/mdScroll in JS) ----------
        def locked(self, who):  # ignore the echo of a scroll we just caused ourselves
            return self.lock == who and time.monotonic() < self.lock_until

        def top_line(self):
            """Fractional 0-based source line at the top of the editor viewport."""
            y = int(self.editor_sw.get_vadjustment().get_value())
            it, _ = self.editor.get_line_at_y(y)
            ly, lh = self.editor.get_line_yrange(it)
            frac = min(1.0, max(0.0, (y - ly) / lh)) if lh > 0 else 0.0
            return it.get_line() + frac

        def on_editor_scroll(self, adj):
            if not self.editor_sw.get_visible() or self.locked("preview"):
                return
            self.lock, self.lock_until = "editor", time.monotonic() + 0.25
            rng = adj.get_upper() - adj.get_page_size()
            ratio = min(1.0, max(0.0, adj.get_value() / rng)) if rng > 0 else 0.0
            self.view.run_javascript("mdScroll(%f,%f)" % (self.top_line(), ratio), None, None, None)

        def on_preview_scroll(self, ucm, result):
            if not self.editor_sw.get_visible() or self.locked("editor"):
                return
            val = result.get_js_value() if hasattr(result, "get_js_value") else result
            try:
                data = json.loads(val.to_string())
                ratio = min(1.0, max(0.0, float(data.get("ratio", 0))))
                line = max(0.0, float(data.get("line", 0)))
            except (ValueError, TypeError, AttributeError):
                return
            adj = self.editor_sw.get_vadjustment()
            rng = adj.get_upper() - adj.get_page_size()
            if rng <= 0:
                return
            y = ratio * rng
            if data.get("ok"):
                ln = int(line)
                last = self.buffer.get_line_count() - 1
                frac = line - ln if ln <= last else 0.0
                ly, lh = self.editor.get_line_yrange(iter_at_line(self.buffer, min(ln, last)))
                w = max(0.0, min(1.0, (ratio - 0.9) * 10 + 1e-9))   # glide to the true end of the editor
                y = (ly + frac * lh) * (1 - w) + y * w
            self.lock, self.lock_until = "preview", time.monotonic() + 0.25
            adj.set_value(max(0.0, min(rng, y)))

    class Viewer(Gtk.Window):
        def __init__(self):
            super().__init__(title="mdview")
            self.set_default_size(1100, 800)
            self.theme = load_theme()
            self.docs, self.mru, self.doc = [], [], None   # open tabs, most-recently-used order, current
            self.switching, self.sw_list, self.sw_i = False, [], 0
            self.find_idle, self.flash, self._dark = 0, None, None

            hb = Gtk.HeaderBar(show_close_button=True, title="mdview")
            self.set_titlebar(hb)
            open_btn = Gtk.Button(label="Open")
